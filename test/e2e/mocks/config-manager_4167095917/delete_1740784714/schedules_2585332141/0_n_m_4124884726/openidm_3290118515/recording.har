          "content": {
            "mimeType": "application/json;charset=utf-8",
            "size": 840,
            "text": "{\"_id\":\"schedule/taskscan_activate\",\"concurrentExecution\":false,\"enabled\":false,\"invokeContext\":{\"numberOfThreads\":5,\"scan\":{\"_queryFilter\":\"((/activeDate le \\\"${Time.nowWithOffset}\\\") AND (!(/inactiveDate pr) or /inactiveDate ge \\\"${Time.nowWithOffset}\\\"))\",\"object\":\"managed/user\",\"recovery\":{\"timeout\":\"10m\"},\"taskState\":{\"completed\":\"/activateAccount/task-completed\",\"started\":\"/activateAccount/task-started\"}},\"task\":{\"script\":{\"globals\":{},\"type\":\"text/javascript\",\"source\":\"var patch = [{ \\\"operation\\\" : \\\"replace\\\", \\\"field\\\" : \\\"/accountStatus\\\", \\\"value\\\" : \\\"active\\\" }];\\n\\nlogger.debug(\\\"Performing Activate Account Task on {} ({})\\\", input.mail, objectID);\\n\\nopenidm.patch(objectID, null, patch); true;\\n\"}},\"waitForCompletion\":false},\"invokeService\":\"taskscanner\",\"persisted\":true,\"repeatInterval\":86400000,\"type\":\"simple\"}"
          },
