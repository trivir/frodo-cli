            "mimeType": "application/json;charset=UTF-8",
            "size": 34740,
            "text": "{\"result\":[{\"_id\":\"ValidatedUsernameNode\",\"name\":\"Platform Username\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to enter their username and stores the input in a configurable state attribute for platform nodes to consume.\"},{\"_id\":\"RequestHeaderNode\",\"name\":\"Request Header Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Gets headers from the request and sets them into the sharedState.\"},{\"_id\":\"SetFailureDetailsNode\",\"name\":\"Set Failure Details\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Set a localized message and additional details to return to the user when the authentication fails\"},{\"_id\":\"RemoveSessionPropertiesNode\",\"name\":\"Remove Session Properties\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Removes the specified properties from a user's session data.\"},{\"_id\":\"IdentityAssertionDecisionNode\",\"name\":\"Identity Assertion\",\"collection\":true,\"tags\":[\"identity assertion\",\"ig\",\"kerberos\",\"windows desktop sso\"],\"metadata\":{\"tags\":[\"identity assertion\",\"ig\",\"kerberos\",\"windows desktop sso\"]},\"help\":\"This node redirects the user to an Identity Assertion server, and receives the redirect back. It ensures the communication with the server is secure.\"},{\"_id\":\"product-WriteFederationInformationNode\",\"name\":\"Write Federation Information\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Links the SAML2 authenticated user and their local account together.\"},{\"_id\":\"SocialOpenIdConnectNode\",\"name\":\"OpenID Connect\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Authenticate users of OpenID Connect-compliant authentication servers.\"},{\"_id\":\"PingOneDeleteUserNode\",\"name\":\"PingOne Delete User\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"This node deletes a user on the PingOne platform.<br><br>The node gets the PingOne user ID from shared state using the <code>pingOneUserId</code> key.\"},{\"_id\":\"LdapDecisionNode\",\"name\":\"LDAP Decision\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\"]},\"help\":\"Verifies that the provided username and password values exist in a specified LDAP user data store, and whether they are expired or locked out.\"},{\"_id\":\"LoginCountDecisionNode\",\"name\":\"Login Count Decision\",\"collection\":true,\"tags\":[\"behavioral\"],\"metadata\":{\"tags\":[\"behavioral\"]},\"help\":\"Compares the user's login count property against a specified condition.\"},{\"_id\":\"CookiePresenceDecisionNode\",\"name\":\"Cookie Presence Decision Node\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]},\"help\":\"Checks if a named cookie is present in the incoming authentication request.\"},{\"_id\":\"IdentifyExistingUserNode\",\"name\":\"Identify Existing User\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Verifies a user with the specified identity attribute exists.\"},{\"_id\":\"PingOneVerifyCompletionDecisionNode\",\"name\":\"PingOne Verify Completion Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"The PingOne Verify Completion Decision node determines the completion status of the end user's identity verification on the PingOne platform. <br><br>The node checks the previous identity verification for the end user and returns an outcome based on the end user's current verification status. <br><br>With a custom script, the node can evaluate any of the user's Verify Transactions and their metadata, instead of just the last transaction.\"},{\"_id\":\"OneTimePasswordSmtpSenderNode\",\"name\":\"OTP Email Sender\",\"collection\":true,\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"]},\"help\":\"Sends an email containing a generated one-time password to the user.\"},{\"_id\":\"CreatePasswordNode\",\"name\":\"Create Password\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Allows users to create a password when provisioning an account.\"},{\"_id\":\"RequiredAttributesDecisionNode\",\"name\":\"Required Attributes Present\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Determines if all attributes required to create a specified object exist within shared state.\"},{\"_id\":\"SetSessionPropertiesNode\",\"name\":\"Set Session Properties\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Sets additional key, value properties to the user's session data.\"},{\"_id\":\"AnonymousSessionUpgradeNode\",\"name\":\"Anonymous Session Upgrade\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Enables anonymous sessions to be upgraded.\"},{\"_id\":\"UsernameCollectorNode\",\"name\":\"Username Collector\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\"]},\"help\":\"Prompts the user to enter their username.\"},{\"_id\":\"CreateObjectNode\",\"name\":\"Create Object\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Creates a specified object with the attributes collected in shared state.\"},{\"_id\":\"IotAuthenticationNode\",\"name\":\"Authenticate Thing\",\"collection\":true,\"tags\":[\"iot\",\"things\"],\"metadata\":{\"tags\":[\"iot\",\"things\"]},\"help\":\"Authenticate a thing using a signed JWT. Authentication is successful if an identity for the thing exists and the JWT can be successfully verified in accordance with the chosen JWT Authentication Method. Registration is required if no identity exists for the thing.\"},{\"_id\":\"SocialGoogleNode\",\"name\":\"Social Google\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Duplicate of the OAuth 2.0 Node preconfigured to work with Google.\"},{\"_id\":\"PageNode\",\"name\":\"Page Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Combines multiple nodes that request input into a single page for display to the user.\"},{\"_id\":\"PingOneVerifyEvaluationNode\",\"name\":\"PingOne Verify Evaluation\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"The PingOne Verify Evaluation node lets administrators integrate PingOne Verify for identity verification within a journey.\"},{\"_id\":\"DeviceSaveNode\",\"name\":\"Device Profile Save\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"product-PingOneProtectResultNode\",\"name\":\"PingOne Protect Result\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Update the risk evaluation configuration, and to modify the completion status of the resource when the risk evaluation is still in progress.\"},{\"_id\":\"PushAuthenticationSenderNode\",\"name\":\"Push Sender\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Sends push notification messages to a device such as a mobile phone, enabling multi-factor authentication.\"},{\"_id\":\"PingOneIdentityMatchNode\",\"name\":\"PingOne Identity Match\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"This node checks whether the user of the Ping AM exists in the PingOne platform.<br><br>If the user already exists in the PingOne platform, the node sets the PingOne user ID in the shared state under a key named <code>pingOneUserId</code>.\"},{\"_id\":\"PassthroughAuthenticationNode\",\"name\":\"Passthrough Authentication\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Authenticates an object against a 3rd party via a connector\"},{\"_id\":\"AccountLockoutNode\",\"name\":\"Account Lockout\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Locks or unlocks the authenticating user's account profile.\"},{\"_id\":\"DeviceTamperingVerificationNode\",\"name\":\"Device Tampering Verification\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"OathTokenVerifierNode\",\"name\":\"OATH Token Verifier\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Collects and verify the One-Time Password code provided by the user.\"},{\"_id\":\"OneTimePasswordCollectorDecisionNode\",\"name\":\"OTP Collector Decision\",\"collection\":true,\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"]},\"help\":\"Prompts the user to enter their one-time password and verifies that input.\"},{\"_id\":\"QueryFilterDecisionNode\",\"name\":\"Query Filter Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Checks if a user's profile matches a specified query filter.\"},{\"_id\":\"product-Saml2Node\",\"name\":\"SAML2 Authentication\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]}},{\"_id\":\"PersistentCookieDecisionNode\",\"name\":\"Persistent Cookie Decision\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]},\"help\":\"Checks for the existence of the persistent cookie specified in the Persistent cookie name property.\"},{\"_id\":\"designer-8ab9f1aad4b4460a9c45d15fb148e221\",\"name\":\"Display State\",\"collection\":true,\"tags\":[\"designer\",\"debug\",\"testing\"],\"metadata\":{\"tags\":[\"designer\",\"debug\",\"testing\"]},\"help\":\"Debug node that displays the shared and transient state of the journey for debugging purposes.\"},{\"_id\":\"AgentDataStoreDecisionNode\",\"name\":\"Agent Data Store Decision\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Verifies that a provided agent ID and password match a web agent or Java agent profile.\"},{\"_id\":\"SetCustomCookieNode\",\"name\":\"Set Custom Cookie\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]},\"help\":\"Creates a custom cookie with supplied properties. The Cookie is set in the next response to client.\"},{\"_id\":\"ProvisionIdmAccountNode\",\"name\":\"Provision IDM Account\",\"collection\":true,\"tags\":[\"idm\",\"federation\"],\"metadata\":{\"tags\":[\"idm\",\"federation\"]},\"help\":\"Redirects users to an IDM instance to provision an account.\"},{\"_id\":\"AcceptTermsAndConditionsNode\",\"name\":\"Accept Terms and Conditions\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to accept or reject the currently active Terms and Conditions.\"},{\"_id\":\"AuthLevelDecisionNode\",\"name\":\"Auth Level Decision\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Compares the current authentication level value against a configured value.\"},{\"_id\":\"product-CertificateValidationNode\",\"name\":\"Certificate Validation Node\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"PollingWaitNode\",\"name\":\"Polling Wait Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Pauses progress of the authentication tree for a specified number of seconds.\"},{\"_id\":\"DeviceLocationMatchNode\",\"name\":\"Device Location Match\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"designer-c15e2efb3deb4d4ea338c74a6440b69f\",\"name\":\"Vector ALU\",\"collection\":true,\"tags\":[\"designer\",\"math\",\"vector\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"math\",\"vector\",\"utilities\"]},\"help\":\"Simple ALU that performs basic binary vector math operations. Outputs the result onto the shared state with key \\\"c\\\".\"},{\"_id\":\"MeterNode\",\"name\":\"Meter\",\"collection\":true,\"tags\":[\"metrics\",\"utilities\"],\"metadata\":{\"tags\":[\"metrics\",\"utilities\"]},\"help\":\"Increments a specified metric key each time tree evaluation passes through the node.\"},{\"_id\":\"CombinedMultiFactorRegistrationNode\",\"name\":\"Combined MFA Registration\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Allows users of mobile devices to register for both Push and OATH authentication methods.\"},{\"_id\":\"WebAuthnRegistrationNode\",\"name\":\"WebAuthn Registration Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Allows users of supported clients to register FIDO2 devices for use during authentication.\"},{\"_id\":\"designer-ef81b1a52c914710b3388caebfe7233a\",\"name\":\"Display Callback\",\"collection\":true,\"tags\":[\"designer\",\"callback\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"callback\",\"utilities\"]},\"help\":\"Displays custom callback to the page\"},{\"_id\":\"RecoveryCodeCollectorDecisionNode\",\"name\":\"Recovery Code Collector Decision\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Verifies a user's recovery code provided when registering a device for multi-factor authentication.\"},{\"_id\":\"DeviceProfileCollectorNode\",\"name\":\"Device Profile Collector\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"SetFailureUrlNode\",\"name\":\"Failure URL\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Sets the URL to be redirected to when authentication fails.\"},{\"_id\":\"UpdateJourneyTimeoutNode\",\"name\":\"Update Journey Timeout\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Updates the timeout for the current journey.\"},{\"_id\":\"SocialNode\",\"name\":\"OAuth 2.0\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Authenticate users of OAuth 2.0-compliant authentication servers.\"},{\"_id\":\"ProvisionDynamicAccountNode\",\"name\":\"Provision Dynamic Account\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Provisions an account following successful authentication by a social identity provider node.\"},{\"_id\":\"SessionDataNode\",\"name\":\"Get Session Data\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Retrieves the value of a specified key from a user's session data.\"},{\"_id\":\"SetPersistentCookieNode\",\"name\":\"Set Persistent Cookie\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]},\"help\":\"Creates a persistent cookie named after the value specified in the Persistent cookie name property.\"},{\"_id\":\"OidcNode\",\"name\":\"OIDC ID Token Validator\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Validates an OIDC provider's ID Token and transforms the attributes according to a configured script.\"},{\"_id\":\"AmsterJwtDecisionNode\",\"name\":\"Amster Jwt Decision Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]}},{\"_id\":\"SocialProviderHandlerNodeV2\",\"name\":\"Social Provider Handler Node\",\"collection\":true,\"tags\":[\"social\",\"federation\",\"platform\"],\"metadata\":{\"tags\":[\"social\",\"federation\",\"platform\"]},\"help\":\"Authenticate a user via a social identity provider and collect useful data from their social profile.\"},{\"_id\":\"designer-c605506774a848f7877b4d17a453bd39\",\"name\":\"Has Session\",\"collection\":true,\"tags\":[\"designer\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"utilities\"]},\"help\":\"Checks if the user has a current session.\"},{\"_id\":\"DeviceBindingStorageNode\",\"name\":\"Device Binding Storage Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]}},{\"_id\":\"WebAuthnAuthenticationNode\",\"name\":\"WebAuthn Authentication Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Allows users of supported clients to use a registered FIDO device during authentication.\"},{\"_id\":\"PushRegistrationNode\",\"name\":\"Push Registration\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Allows users of mobile devices to register Push Notifications for use during authentication.\"},{\"_id\":\"TimerStopNode\",\"name\":\"Timer Stop\",\"collection\":true,\"tags\":[\"metrics\",\"utilities\"],\"metadata\":{\"tags\":[\"metrics\",\"utilities\"]},\"help\":\"Records the time elapsed since tree evaluation passed through the specified Timer Start Node in the specified metric name.\"},{\"_id\":\"product-PingOneProtectEvaluationNode\",\"name\":\"PingOne Protect Evaluation\",\"collection\":true,\"tags\":[\"risk\",\"sdk\"],\"metadata\":{\"tags\":[\"risk\",\"sdk\"]},\"help\":\"Risk evaluations calculate the risk level and other risk-related details associated with an event.\"},{\"_id\":\"EmailTemplateNode\",\"name\":\"Email Template Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Sends an email to the user.\"},{\"_id\":\"SocialOAuthIgnoreProfileNode\",\"name\":\"Social Ignore Profile\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Allows an SSO token to be issued after successful social authentication, regardless of the existence of a local user profile.\"},{\"_id\":\"EmailSuspendNode\",\"name\":\"Email Suspend Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Sends an email to the user. The email will include a link to return to this node within the tree.\"},{\"_id\":\"AttributeCollectorNode\",\"name\":\"Attribute Collector\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to enter any specified attributes.\"},{\"_id\":\"AnonymousUserNode\",\"name\":\"Anonymous User Mapping\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Allows users to log in to your application or web site without providing credentials by assuming the identity of a specified, existing user account.\"},{\"_id\":\"product-ReCaptchaNode\",\"name\":\"Legacy CAPTCHA\",\"collection\":true,\"tags\":[\"risk\",\"deprecated\"],\"metadata\":{\"tags\":[\"risk\",\"deprecated\"]},\"help\":\"Verifies the response token received from the CAPTCHA verifier in addition to creating a CAPTCHA callback for the UI to interact with, default values are for Google ReCAPTCHA. Note that this has been superceded by the new CAPTCHA node, which should be used in all cases over this node.\"},{\"_id\":\"product-CaptchaNode\",\"name\":\"CAPTCHA\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Verifies the response token received from the CAPTCHA verifier in addition to creating a CAPTCHA callback for the UI to interact with, default values are for Google ReCAPTCHA.\"},{\"_id\":\"AttributeValueDecisionNode\",\"name\":\"Attribute Value Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Verifies the user's specified attribute matches a specified condition.\"},{\"_id\":\"product-PingOneProtectInitializeNode\",\"name\":\"PingOne Protect Initialize\",\"collection\":true,\"tags\":[\"risk\",\"sdk\"],\"metadata\":{\"tags\":[\"risk\",\"sdk\"]},\"help\":\"Initialize the PingOne Protect SDK on the client device, using the configuration provided by the node properties.\"},{\"_id\":\"OneTimePasswordGeneratorNode\",\"name\":\"HOTP Generator\",\"collection\":true,\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"]},\"help\":\"Creates a string of random digits, of the length specified, to be used in one-time password verification.\"},{\"_id\":\"PasswordCollectorNode\",\"name\":\"Password Collector\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\"]},\"help\":\"Prompts the user to enter their password.\"},{\"_id\":\"ValidatedPasswordNode\",\"name\":\"Platform Password\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to enter their password and stores the input in a configurable state attribute for platform nodes to consume.\"},{\"_id\":\"AttributePresentDecisionNode\",\"name\":\"Attribute Present Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Checks if an attribute is present on an object regardless of whether the field is private\"},{\"_id\":\"KbaDecisionNode\",\"name\":\"KBA Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Checks if the number of KBA questions defined for the user meets the minimum required by the system.\"},{\"_id\":\"SetSuccessDetailsNode\",\"name\":\"Set Success Details\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Set additional details to return to the user when authentication succeeds. The details set can't override the predefined keys: <code>tokenId</code>, <code>successURL</code>, or <code>realm</code>.\"},{\"_id\":\"PingOneCreateUserNode\",\"name\":\"PingOne Create User\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"This node creates a user on the PingOne platform. If the user is successfully created, the node sets the PingOne user ID in the shared state under a key named <code>pingOneUserId</code>.\"},{\"_id\":\"designer-c6063fb2f5dc42dd9772bedc93898bd8\",\"name\":\"ALU\",\"collection\":true,\"tags\":[\"designer\",\"math\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"math\",\"utilities\"]},\"help\":\"Simple ALU that performs basic binary math operations. Expects an \\\"x\\\" and \\\"y\\\" value on the shared state, and will produce a new \\\"z\\\" value on the shared state as output.\"},{\"_id\":\"ZeroPageLoginNode\",\"name\":\"Zero Page Login Collector\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\"]},\"help\":\"Checks whether selected headers are provided in the incoming authentication request, and if so, uses their value as the provided username and password.\"},{\"_id\":\"ProfileCompletenessDecisionNode\",\"name\":\"Profile Completeness Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Checks if the user's profile contains a specified percentage of non-null, user-viewable, and user-editable fields.\"},{\"_id\":\"SetErrorDetailsNode\",\"name\":\"Set Error Details\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Set a localized message and additional details to return to the user when an error occurs\"},{\"_id\":\"SetStateNode\",\"name\":\"Set State\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Adds specified attributes to the state. Do not use for sensitive data.\"},{\"_id\":\"SelectIdPNode\",\"name\":\"Select Identity Provider\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to choose a social ID provider.\"},{\"_id\":\"OathDeviceStorageNode\",\"name\":\"OATH Device Storage Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Stores devices which have previously been saved into the transient state by the OathRegistrationNode.\"},{\"_id\":\"PushWaitNode\",\"name\":\"Push Wait Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Pauses progress of the authentication tree for a specified number of seconds while waiting for Push Authentication request being processed. For Push-to-Challenge type, displays the number challenge to be selected by the user.\"},{\"_id\":\"PushResultVerifierNode\",\"name\":\"Push Result Verifier Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Validates the user's response to a previously sent push notification message.\"},{\"_id\":\"DeviceBindingNode\",\"name\":\"Device Binding\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]}},{\"_id\":\"TimerStartNode\",\"name\":\"Timer Start\",\"collection\":true,\"tags\":[\"metrics\",\"utilities\"],\"metadata\":{\"tags\":[\"metrics\",\"utilities\"]},\"help\":\"Starts a named timer metric.\"},{\"_id\":\"GetAuthenticatorAppNode\",\"name\":\"Get Authenticator App\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Presents a custom, localized message to the user with links to the Authenticator on App stores.\"},{\"_id\":\"DebugNode\",\"name\":\"Debug Node\",\"collection\":true,\"tags\":[],\"metadata\":{\"tags\":[]},\"help\":\"Activate debug mode to output tree data to debug logs. Optionally, enable the debug popup to display debug logs as you traverse through the login tree\"},{\"_id\":\"ConsentNode\",\"name\":\"Consent Collector\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Prompts the user to provide consent to sharing their profile data.\"},{\"_id\":\"MultiFactorRegistrationOptionsNode\",\"name\":\"MFA Registration Options\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Presents a custom, localized message to the user and prompts the user to choose to register, skip or opt-out the second factor authentication method\"},{\"_id\":\"ChoiceCollectorNode\",\"name\":\"Choice Collector\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Presents the user with two or more options defined within the node's configuration.\"},{\"_id\":\"RecoveryCodeDisplayNode\",\"name\":\"Recovery Code Display Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Retrieves generated recovery codes from the transient state and presents them to the user, for safe-keeping.\"},{\"_id\":\"IotRegistrationNode\",\"name\":\"Register Thing\",\"collection\":true,\"tags\":[\"iot\",\"things\"],\"metadata\":{\"tags\":[\"iot\",\"things\"]},\"help\":\"Register a thing using a signed JWT. Registration is successful if the JWT can be successfully verified in accordance with the chosen JWT Registration Method. The JWT claims are used to create a new identity for a thing.\"},{\"_id\":\"designer-e5ad0110c8ee4dafaae983003cd05d4a\",\"name\":\"Generate JWT\",\"collection\":true,\"tags\":[\"designer\",\"Utilities\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"Utilities\",\"utilities\"]},\"help\":\"Generate a signed JWT using the HMAC SHA-256 algorithm.\"},{\"_id\":\"product-CertificateUserExtractorNode\",\"name\":\"Certificate User Extractor Node\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"QueryParameterNode\",\"name\":\"Query Parameter Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Gets query parameters from the URL of the request and sets them into the sharedState.\"},{\"_id\":\"OathRegistrationNode\",\"name\":\"OATH Registration\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Allows users of mobile devices to register One-Time Password for use during authentication.\"},{\"_id\":\"SocialProviderHandlerNode\",\"name\":\"Legacy Social Provider Handler Node\",\"collection\":true,\"tags\":[\"social\",\"federation\",\"platform\",\"deprecated\"],\"metadata\":{\"tags\":[\"social\",\"federation\",\"platform\",\"deprecated\"]},\"help\":\"This node is deprecated. Please use the Social Provider Handler Node. Authenticate a user via a social identity provider and collect useful data from their social profile.\"},{\"_id\":\"product-CaptchaEnterpriseNode\",\"name\":\"reCAPTCHA Enterprise\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Enables the use of Google reCAPTCHA Enterprise in journeys.\"},{\"_id\":\"OptOutMultiFactorAuthenticationNode\",\"name\":\"Opt-out Multi-Factor Authentication\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Set skippable attribute on the authenticating user's account profile.\"},{\"_id\":\"ConfigProviderNode\",\"name\":\"Configuration Provider\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Allows dynamic resolution of configuration based on the tree context at the point this node is executed.\"},{\"_id\":\"EnableDeviceManagementNode\",\"name\":\"Enable Device Management\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Lets the user manage their devices in a self-service journey.\"},{\"_id\":\"TimeSinceDecisionNode\",\"name\":\"Time Since Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Checks if a specified amount of time has passed since the user was registered.\"},{\"_id\":\"MetadataNode\",\"name\":\"State metadata\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Returns selected attributes from the shared state as metadata\"},{\"_id\":\"DataStoreDecisionNode\",\"name\":\"Data Store Decision\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\"]},\"help\":\"Verifies that the username and password values exist in the data store configured in the realm.\"},{\"_id\":\"DeviceGeoFencingNode\",\"name\":\"Device Geofencing\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"OneTimePasswordSmsSenderNode\",\"name\":\"OTP SMS Sender\",\"collection\":true,\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"otp\",\"mfa\",\"multi-factor authentication\"]},\"help\":\"Uses an email-to-SMS gateway provider to send an SMS message containing a generated one-time password to the user.\"},{\"_id\":\"AccountActiveDecisionNode\",\"name\":\"Account Active Decision\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Checks if the current user's account is active.\"},{\"_id\":\"SetSuccessUrlNode\",\"name\":\"Success URL\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Sets the URL to be redirected to when authentication succeeds.\"},{\"_id\":\"DeviceSigningVerifierNode\",\"name\":\"Device Signing Verifier\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]}},{\"_id\":\"product-CertificateCollectorNode\",\"name\":\"Certificate Collector Node\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"DisplayUserNameNode\",\"name\":\"Display Username\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Presents the user's username for use in username retrieval trees.\"},{\"_id\":\"WebAuthnDeviceStorageNode\",\"name\":\"WebAuthn Device Storage Node\",\"collection\":true,\"tags\":[\"mfa\",\"multi-factor authentication\"],\"metadata\":{\"tags\":[\"mfa\",\"multi-factor authentication\"]},\"help\":\"Stores devices which have previously been saved into the transient state by the WebAuthnRegistrationNode.\"},{\"_id\":\"IncrementLoginCountNode\",\"name\":\"Increment Login Count\",\"collection\":true,\"tags\":[\"behavioral\"],\"metadata\":{\"tags\":[\"behavioral\"]},\"help\":\"Increments the successful login count property of a user.\"},{\"_id\":\"designer-session\",\"name\":\"Has Session AM\",\"collection\":true,\"tags\":[\"designer\",\"utilities\"],\"metadata\":{\"tags\":[\"designer\",\"utilities\"]},\"help\":\"Checks if the user has a current session.\"},{\"_id\":\"ModifyAuthLevelNode\",\"name\":\"Modify Auth Level\",\"collection\":true,\"tags\":[\"risk\"],\"metadata\":{\"tags\":[\"risk\"]},\"help\":\"Increases or decreases the current authentication level value.\"},{\"_id\":\"RetryLimitDecisionNode\",\"name\":\"Retry Limit Decision\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Allows the specified number of passes through to the Retry outcome path, before continuing tree evaluation along the Reject outcome path.\"},{\"_id\":\"TermsAndConditionsDecisionNode\",\"name\":\"Terms and Conditions Decision\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Verifies the user has accepted the active set of Terms and Conditions.\"},{\"_id\":\"KbaVerifyNode\",\"name\":\"KBA Verification\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Presents KBA questions to the user, collects answers to those questions, and verifies the input against the user's stored answers.\"},{\"_id\":\"FlowControlNode\",\"name\":\"Flow Control\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Control the flow of authentication requests.\"},{\"_id\":\"InnerTreeEvaluatorNode\",\"name\":\"Inner Tree Evaluator\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Allows the nesting and evaluation of authentication trees as children within a parent tree.\"},{\"_id\":\"PatchObjectNode\",\"name\":\"Patch Object\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Patches an object with the attributes within shared state.\"},{\"_id\":\"SocialFacebookNode\",\"name\":\"Social Facebook\",\"collection\":true,\"tags\":[\"social\",\"federation\"],\"metadata\":{\"tags\":[\"social\",\"federation\"]},\"help\":\"Duplicate of the OAuth 2.0 Node preconfigured to work with Facebook.\"},{\"_id\":\"MessageNode\",\"name\":\"Message Node\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Presents a custom, localized message to the user and prompts them to choose a positive or negative answer.\"},{\"_id\":\"RegisterLogoutWebhookNode\",\"name\":\"Register Logout Webhook\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Registers the specified webhook to trigger when a user's session ends.\"},{\"_id\":\"ScriptedDecisionNode\",\"name\":\"Scripted Decision\",\"collection\":true,\"tags\":[\"utilities\"],\"metadata\":{\"tags\":[\"utilities\"]},\"help\":\"Executes a script and continues along the path matching the result.\"},{\"_id\":\"DeviceMatchNode\",\"name\":\"Device Match\",\"collection\":true,\"tags\":[\"contextual\"],\"metadata\":{\"tags\":[\"contextual\"]}},{\"_id\":\"product-KerberosNode\",\"name\":\"Kerberos Node\",\"collection\":true,\"tags\":[\"basic authn\",\"basic authentication\",\"kerberos\",\"windows\"],\"metadata\":{\"tags\":[\"basic authn\",\"basic authentication\",\"kerberos\",\"windows\"]},\"help\":\"Enables Windows desktop single sign on such that a user who has already authenticated with a Kerberos Key Distribution Center can authenticate to AM\"},{\"_id\":\"KbaCreateNode\",\"name\":\"KBA Definition\",\"collection\":true,\"tags\":[\"identity management\"],\"metadata\":{\"tags\":[\"identity management\"]},\"help\":\"Collects KBA question and answer definitions from user and saves the provided input.\"}]}"
