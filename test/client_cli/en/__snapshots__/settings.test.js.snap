exports[`CLI help interface for 'settings' should be expected english 1`] = `
"Usage: frodo settings [options] [command]

Manage local frodo CLI settings (not remote Ping/AIC configuration -- see "frodo
config"/"frodo config-manager" for that).

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Commands:
  theme             Manage the CLI color theme.
"
`;
