exports[`CLI help interface for 'idm schema object' should be expected english 1`] = `
"Usage: frodo idm schema object [options] [command]

Manage IDM managed-object configuration (schema, notifications, etc.).

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Commands:
  export            Export IDM managed-object configuration (schema,
                    notifications, etc.).
  help              display help for command
  import            Import IDM managed-object configuration (schema,
                    notifications, etc.). Prompts for confirmation before
                    importing schema changes, unless -y/--yes is passed.
"
`;
